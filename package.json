{
  "name": "animation-chatbot",
  "version": "0.1.0",
  "private": true,
  "description": "A rigged 2D character that reacts to what it says. Portfolio demo.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "screenshot": "./node_modules/.bin/jiti scripts/capture-screenshot.ts",
    "verify:bundle": "node scripts/verify-no-secrets.mjs",
    "dev:vinext": "vite dev --port 3001",
    "build:vinext": "vite build",
    "preview:vinext": "vite preview --host 0.0.0.0",
    "deploy:vinext": "vinext-cloudflare deploy"
  },
  "dependencies": {
    "next": "16.4.2",
    "pixi-live2d-display": "0.5.0-beta",
    "pixi.js": "^7.4.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-server-dom-webpack": "^19.3.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^2.0.0-beta.v.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.2.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.13.1",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vinext/cloudflare": "^1.1.1",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitejs/plugin-rsc": "^0.5.38",
    "cf": "^1.0.0-beta.18",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.2",
    "jsdom": "^30.1.3",
    "prettier": "^3.4.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.7.3",
    "vinext": "^1.2.1",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "comments": {
    "renderer-version-pair": "T003: pixi-live2d-display 0.5.0-beta is the ONLY published version peering on pixi.js ^7 (verified via npm view: 0.4.0 peers on @pixi/* ^6). PixiJS v8 is unsupported by every published version. Do not bump pixi.js to 8, and do not 'upgrade' pixi-live2d-display to the 0.4.0 stable tag - that is a downgrade to the v6 line and will break the canvas.",
    "engines-note": "Next 16 + React 19. Node 20+ required; developed on Node 24. Bumped from Next 15 to clear a high-severity transitive postcss advisory that had no non-major fix."
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "unrs-resolver@1.12.2": true
  },
  "type": "module",
  "optionalDependencies": {
    "@rolldown/binding-win32-x64-msvc": "^1.2.14"
  }
}
