# Copy to .env.local and fill in. Never commit .env.local.
# Constitution, Additional Constraints: secrets come from environment, never from source.

# --- Provider (contracts/chat-api.md, research D5) ---------------------------
# Free tier, no card required: https://console.groq.com
GROQ_API_KEY=
# Swapping provider is these three values and nothing else (FR-032, SC-012).
GROQ_BASE_URL=https://api.groq.com/openai/v1
# Confirm against the provider's live model list at setup - model ids are retired over time (D5).
GROQ_MODEL=llama-3.1-8b-instant

# --- Global daily ceiling (FR-028, research D7) ------------------------------
# One integer per UTC day, shared by every visitor. No per-visitor limit exists,
# and no visitor identifier is ever derived or stored.
DAILY_REQUEST_LIMIT=150

# --- Counter store (Vercel Upstash integration provides both) ----------------
# Without these the quota check fails CLOSED by design: every send returns the
# temporary-limit message. That is correct behaviour, not a bug (D7).
KV_REST_API_URL=
KV_REST_API_TOKEN=
